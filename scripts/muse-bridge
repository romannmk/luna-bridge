#!/bin/sh
# muse-bridge — open/close the bridge from the terminal (macOS).
#
# Thin wrapper around the launchd agent installed by scripts/install.sh
# (label com.muse.bridge, plist in ~/Library/LaunchAgents). Dependency-free:
# POSIX shell + launchctl + curl only.
#
#   muse-bridge start       open the bridge   (launchctl load + health check)
#   muse-bridge stop        close the bridge  (launchctl unload)
#   muse-bridge restart     unload + load     (e.g. after editing config.json)
#   muse-bridge status      loaded? pid? health?
#   muse-bridge foreground  run attached to this terminal, logs to stdout
#                           (Ctrl+C stops it; the launchd agent stays unloaded)
#
# Environment overrides:
#   MUSE_BRIDGE_PLIST       plist path (default ~/Library/LaunchAgents/com.muse.bridge.plist)
#   MUSE_BRIDGE_PORT        port for the health check (default 8787)
#   MUSE_BRIDGE_HEALTH_URL  full health URL; set this when bind_mode does not
#                           listen on 127.0.0.1 (tailscale/lan/custom)
#   MUSE_BRIDGE_SERVER      server.js path for `foreground` (default: next to
#                           this script's repo, else taken from the plist)
#   MUSE_BRIDGE_NODE        node binary for `foreground` (default: node)
set -u

LABEL="com.muse.bridge"
PLIST="${MUSE_BRIDGE_PLIST:-$HOME/Library/LaunchAgents/com.muse.bridge.plist}"
HEALTH_URL="${MUSE_BRIDGE_HEALTH_URL:-http://127.0.0.1:${MUSE_BRIDGE_PORT:-8787}/health}"

usage() {
  echo "usage: muse-bridge <start|stop|restart|status|foreground>"
  echo "  start       open the bridge (load the launchd agent, then check health)"
  echo "  stop        close the bridge (unload the launchd agent)"
  echo "  restart     unload + load (e.g. after editing config.json)"
  echo "  status      show whether the agent is loaded and the bridge is healthy"
  echo "  foreground  run the bridge in this terminal, logs to stdout (Ctrl+C stops it)"
}

# Loaded-state + pid from launchctl. Sets LOADED=1/0 and PID (may be empty).
probe_launchd() {
  LIST_OUT="$(launchctl list "$LABEL" 2>/dev/null)"
  if [ $? -eq 0 ]; then
    LOADED=1
    PID="$(printf '%s\n' "$LIST_OUT" | sed -n 's/.*"PID" = \([0-9][0-9]*\);.*/\1/p' | head -n 1)"
  else
    LOADED=0
    PID=""
  fi
}

# One health probe. Sets HEALTH_BODY; returns curl's exit status.
probe_health() {
  HEALTH_BODY="$(curl -s -m 2 "$HEALTH_URL" 2>/dev/null)"
  return $?
}

# Wait briefly for the just-loaded server to answer health. Returns 0/1.
wait_health() {
  i=0
  while [ "$i" -lt 25 ]; do
    if probe_health; then return 0; fi
    i=$((i + 1))
    sleep 0.2
  done
  return 1
}

health_ok_line() {
  echo "muse-bridge: health OK — $HEALTH_URL -> $HEALTH_BODY"
}

health_fail_line() {
  echo "muse-bridge: health check failed — no answer from $HEALTH_URL"
  echo "  The bridge may still be starting, or bind_mode may not listen on"
  echo "  this address (tailscale/lan/custom) — then set MUSE_BRIDGE_HEALTH_URL"
  echo "  to the \"Listening on\" address from logs/bridge.out.log."
}

require_plist() {
  if [ ! -f "$PLIST" ]; then
    echo "muse-bridge: launchd agent not installed (no plist at $PLIST)." >&2
    echo "  Run the installer from the repo directory first: sh scripts/install.sh" >&2
    exit 1
  fi
}

cmd_start() {
  require_plist
  probe_launchd
  if [ "$LOADED" -eq 1 ]; then
    echo "muse-bridge: already open (launchd agent $LABEL is loaded${PID:+, pid $PID})."
  else
    if ! launchctl load "$PLIST"; then
      echo "muse-bridge: launchctl load failed for $PLIST" >&2
      exit 1
    fi
    echo "muse-bridge: opened (launchd agent $LABEL loaded)."
  fi
  if wait_health; then
    health_ok_line
    exit 0
  fi
  health_fail_line >&2
  exit 1
}

cmd_stop() {
  probe_launchd
  if [ "$LOADED" -eq 0 ]; then
    echo "muse-bridge: already stopped (launchd agent $LABEL is not loaded)."
    exit 0
  fi
  if ! launchctl unload "$PLIST"; then
    echo "muse-bridge: launchctl unload failed for $PLIST" >&2
    exit 1
  fi
  echo "muse-bridge: closed (launchd agent $LABEL unloaded)."
  exit 0
}

cmd_restart() {
  require_plist
  probe_launchd
  if [ "$LOADED" -eq 1 ]; then
    if ! launchctl unload "$PLIST"; then
      echo "muse-bridge: launchctl unload failed for $PLIST" >&2
      exit 1
    fi
  fi
  if ! launchctl load "$PLIST"; then
    echo "muse-bridge: launchctl load failed for $PLIST" >&2
    exit 1
  fi
  echo "muse-bridge: restarted (launchd agent $LABEL reloaded)."
  if wait_health; then
    health_ok_line
    exit 0
  fi
  health_fail_line >&2
  exit 1
}

cmd_status() {
  probe_launchd
  if [ "$LOADED" -eq 1 ]; then
    echo "muse-bridge: loaded (launchd agent $LABEL${PID:+, pid $PID})"
  else
    echo "muse-bridge: not loaded (launchd agent $LABEL is not running — open it with: muse-bridge start)"
  fi
  if probe_health; then
    health_ok_line
    exit 0
  fi
  health_fail_line
  exit 1
}

# Locate server.js for `foreground`: explicit override, then the repo this
# script lives in (scripts/../server.js when run uninstalled), then the
# path recorded in the installed plist (the ~/.local/bin copy). Sets SERVER.
resolve_server() {
  if [ -n "${MUSE_BRIDGE_SERVER:-}" ]; then
    SERVER="$MUSE_BRIDGE_SERVER"
    [ -f "$SERVER" ] && return 0
    return 1
  fi
  SCRIPT_DIR="$(cd "$(dirname "$0")" 2>/dev/null && pwd || echo .)"
  if [ -f "$SCRIPT_DIR/../server.js" ]; then
    SERVER="$(cd "$SCRIPT_DIR/.." && pwd)/server.js"
    return 0
  fi
  if [ -f "$PLIST" ]; then
    SERVER="$(sed -n 's:.*<string>\(.*/server\.js\)</string>.*:\1:p' "$PLIST" | head -n 1)"
    if [ -n "$SERVER" ] && [ -f "$SERVER" ]; then return 0; fi
  fi
  return 1
}

cmd_foreground() {
  # Refuse to run a second copy next to the background agent: both would
  # fight over the same port. The fix is one command away, so say it.
  probe_launchd
  if [ "$LOADED" -eq 1 ]; then
    echo "muse-bridge: the bridge is already open in the background (launchd agent $LABEL${PID:+, pid $PID})." >&2
    echo "  Stop it first, then re-run: muse-bridge stop" >&2
    exit 1
  fi
  if ! resolve_server; then
    echo "muse-bridge: cannot find server.js (looked next to this script and in $PLIST)." >&2
    echo "  Run it from the repo instead (node server.js --foreground), or set MUSE_BRIDGE_SERVER." >&2
    exit 1
  fi
  NODE_BIN="${MUSE_BRIDGE_NODE:-node}"
  if ! command -v "$NODE_BIN" >/dev/null 2>&1 && [ ! -x "$NODE_BIN" ]; then
    echo "muse-bridge: node binary not found ($NODE_BIN) — set MUSE_BRIDGE_NODE to its full path." >&2
    exit 1
  fi
  echo "muse-bridge: running in the foreground — logs to this terminal (stdout), Ctrl+C to stop."
  exec "$NODE_BIN" "$SERVER" --foreground
}

case "${1:-}" in
  start)   cmd_start ;;
  stop)    cmd_stop ;;
  restart) cmd_restart ;;
  status)  cmd_status ;;
  foreground)
    if [ "$#" -ne 1 ]; then usage >&2; exit 2; fi
    cmd_foreground ;;
  help | -h | --help) usage; exit 0 ;;
  *) usage >&2; exit 2 ;;
esac
